# Rakshak AI Environment Variables Example
APP_NAME="Rakshak AI — Tactical Crisis Response API"
APP_VERSION=2.4.0
DEBUG=True

# ScyllaDB Low-Latency Cluster Configuration
# For local Docker setup: 127.0.0.1:9042
SCYLLA_HOSTS=["127.0.0.1"]
SCYLLA_PORT=9042
SCYLLA_KEYSPACE=rakshak_tactical
SCYLLA_USER=""
SCYLLA_PASSWORD=""
SCYLLA_LOCAL_DC=datacenter1
SCYLLA_TIMEOUT_SECONDS=3.0
SCYLLA_CONNECT_TIMEOUT=5.0

# AI Engine Configuration
AI_CONFIDENCE_THRESHOLD=0.70
AI_MOCK_FALLBACK=True

# CORS
CORS_ORIGINS=["*"]
